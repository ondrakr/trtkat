# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App Store and Google Play listing URLs for store badges on the landing page.
VITE_APP_STORE_URL="https://apps.apple.com/app/trtkat/id0000000000"
VITE_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=com.trtkat.app"

# Production site URL (used for sitemap and canonical links).
VITE_SITE_URL="https://www.trtkat.cz"

# Google Analytics 4 measurement ID (optional override; default is G-20QXHN7DCC).
VITE_GA4_MEASUREMENT_ID="G-20QXHN7DCC"

# Supabase (client — safe for browser)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Supabase (server only — Vercel env, NEVER expose to client)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Waitlist webhook URL (optional fallback if Supabase not configured).
WAITLIST_WEBHOOK_URL=""
